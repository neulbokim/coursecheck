# Vercel Marketplace에서 Neon을 연결하면 자동으로 설정됩니다.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# 건의 관리 화면(/admin) 접속 키. 길고 무작위한 값으로 설정하세요.
# 예: openssl rand -base64 32
ADMIN_TOKEN=

# 이용 기록 사본과 에브리타임 실패 사유를 남길 폴더. 비워두면 개발 중에는
# .local-logs/에 쌓이고, 배포에서는 남기지 않습니다.
# off로 두면 개발 중에도 남기지 않습니다.
LOCAL_LOG_DIR=

# 이용 기록·에브리타임 실패를 데이터베이스에 넣을지. 개발 서버도 위 DATABASE_URL을
# 그대로 쓰기 때문에, 비워두면 배포에서만 넣습니다. 개발 중 눌러 본 것이 운영 집계에
# 섞이면 익명 행이라 나중에 골라 지울 수 없습니다.
# on으로 두면 개발 중에도 넣고, off로 두면 배포에서도 넣지 않습니다.
# 어느 쪽이든 .local-logs/ 사본은 그대로 남습니다.
ANALYTICS_SINK=
